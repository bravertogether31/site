# Public Supabase settings used by the browser and SSR build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase settings. These may use the same URL/publishable key above.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional YouTube Data API key. Video embeds work without it; this only enables public comments.
YOUTUBE_API_KEY=

# Generic OpenAI-compatible fallback used when feature-specific values below are empty.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
AI_STRUCTURED_OUTPUTS=true

# Limited support AI. A small free-tier model is appropriate.
SUPPORT_AI_API_KEY=
SUPPORT_AI_BASE_URL=https://api.groq.com/openai/v1
SUPPORT_AI_MODEL=openai/gpt-oss-20b

# Contract Decoder AI. This can use a different small model/provider.
DECODER_AI_API_KEY=
DECODER_AI_BASE_URL=https://api.groq.com/openai/v1
DECODER_AI_MODEL=openai/gpt-oss-20b
DECODER_AI_STRUCTURED_OUTPUTS=true

# Optional private salt for hashing anonymous AI rate-limit identities.
AI_RATE_LIMIT_SALT=

# Optional staged, READ-ONLY public pages migration (default is the original Supabase provider).
# Do not switch protected member/admin routes or production Auth with this flag alone.
BRAVER_PUBLIC_DATA_PROVIDER=supabase
# Neon Auth and Data API URLs are public HTTPS endpoints; they are NOT service credentials.
NEON_AUTH_BASE_URL=
NEON_DATA_API_URL=
# For a future verified, server-only private/auth migration (never use VITE_ prefix).
NEON_DATABASE_URL=

# Legacy account sign-in bridge: disabled until Neon Auth production tests pass.
NEON_LEGACY_LOGIN_ENABLED=0
NEON_LEGACY_LOGIN_RATE_SALT=
BRAVER_SITE_ORIGIN=https://bravertogether.site

# Local migration tests only; never set on Render production.
BRAVER_ALLOW_LOCALHOST_TESTS=0
NEON_AUTH_PROXY_ENABLED=0
NEON_AUTH_COOKIE_SECRET=

# Build-time frontend provider (must match runtime BRAVER_AUTH_PROVIDER).
VITE_BRAVER_AUTH_PROVIDER=supabase
# Runtime backend provider (Supabase remains the production default).
BRAVER_AUTH_PROVIDER=supabase
